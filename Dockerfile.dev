ARG BASE_IMAGE=aniflive-tts:1.3.0-cu128
ARG SDK_BUILDER_IMAGE=rust:1.98.1-bookworm@sha256:93ce27a88655056a51dbdd8f5f2d7ddc071c7b0070fb288a37b5a285fc83971e
FROM ${SDK_BUILDER_IMAGE} AS sdk-wheel
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-dev python3-venv cmake pkg-config \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/sdk-build \
    && /opt/sdk-build/bin/python -m pip install --no-cache-dir \
       setuptools==84.0.0 wheel==0.48.0 setuptools-rust==1.13.0
ENV PYO3_PYTHON=/opt/sdk-build/bin/python
WORKDIR /sdk
COPY pyproject.toml MANIFEST.in Cargo.toml Cargo.lock rust-toolchain.toml README.md LICENSE /sdk/
COPY rust /sdk/rust
COPY src /sdk/src
COPY licenses/SDK-NATIVE-* /sdk/licenses/
RUN --mount=type=cache,id=aniflive-sdk-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=aniflive-sdk-cargo-target,target=/sdk/target,sharing=locked \
    /opt/sdk-build/bin/python -m pip wheel --no-deps --no-build-isolation --wheel-dir /wheels /sdk

FROM ${BASE_IMAGE}

ARG VERSION=1.5.0-beta.1
LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="PolyForm-Noncommercial-1.0.0" \
      org.opencontainers.image.source="https://github.com/Hiruynk/AnifLive-TTS"

# Development-only source overlay. The explicit v1.3 production base is the
# immutable golden runtime; the resulting image is labeled with the requested release version.
# Dependencies and offline resources remain inherited while GPU hot-path iterations
# replace only the installed AnifLive-TTS package. The isolated builder compiles
# its native client; final-image installation remains offline and dependency-free.
COPY --from=sdk-wheel /wheels/ /tmp/aniflive-sdk-wheels/
RUN python -m pip install --no-deps --force-reinstall /tmp/aniflive-sdk-wheels/*.whl \
    && rm -rf /tmp/aniflive-sdk-wheels
COPY webui /app/webui
COPY scripts/build_gpt_step_short.py /app/scripts/build_gpt_step_short.py
COPY minimal_inference/export_onnx.py /app/minimal_inference/export_onnx.py
COPY minimal_inference/onnx_to_fp16.py /app/minimal_inference/onnx_to_fp16.py
COPY minimal_inference/run_trt_inference.py /app/minimal_inference/run_trt_inference.py
COPY minimal_inference/GPT_SoVITS/process_ckpt.py /app/minimal_inference/GPT_SoVITS/process_ckpt.py
COPY minimal_inference/GPT_SoVITS/module/models.py /app/minimal_inference/GPT_SoVITS/module/models.py
