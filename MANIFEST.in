include Cargo.toml Cargo.lock rust-toolchain.toml
recursive-include rust Cargo.toml *.rs
recursive-include rust/macos-v5turbo *.lock *.txt
recursive-include scripts/macos-release *.sh *.json *.example
recursive-include scripts/macos-v5turbo *.py
include scripts/macos-qualification/fp16_package_refresh.py
include docs/MACOS_INSTALLATION_EN.md docs/MACOS_INSTALLATION_ZH.md
include scripts/v5_*.py
include scripts/benchmark_release.py scripts/benchmark_audio.py scripts/benchmark_readme.py
recursive-include scripts/v5_graph *.json *-topology.onnx
recursive-include scripts/v5_native_sources *.c *.cpp *.h
global-exclude AGENTS.md
global-exclude *_CODEX_PLAN.md
prune .local-sdk
prune target
prune build
global-exclude *.so *.pyd *.dylib *.pyc

prune .local-stable
global-exclude *_IMPLEMENTATION_PLAN.md
global-exclude *_MASTER_START_PROMPT.md
