# Copy this file to a user-owned location, edit the paths, then set
# ANIFLIVE_TTS_MACOS_ENV_FILE to that copy before using the release scripts.
# This file contains placeholders, no secrets, models, or reference audio.

ANIFLIVE_TTS_MACOS_RUNTIME_ROOT="${HOME}/Library/Application Support/AnifLive-TTS/macos-v1.5"
ANIFLIVE_TTS_MACOS_DATA_ROOT="${ANIFLIVE_TTS_MACOS_RUNTIME_ROOT}/assets"
ANIFLIVE_TTS_VENV="${ANIFLIVE_TTS_MACOS_RUNTIME_ROOT}/venv"

# Supply an authorized, converted model package with manifest.json,
# checksums.json and native model assets. A shared-base package can start
# without a fixed voice; add your own Voice and Reference through the API.
ANIFLIVE_TTS_MODEL_PACKAGE="/path/to/authorized/gsv-v5turbo-model-package"

# Provision these locally; the scripts do not download model/reference assets.
ANIFLIVE_TTS_SHARED_DIR="${ANIFLIVE_TTS_MACOS_DATA_ROOT}/upstream"
ANIFLIVE_TTS_SOURCE_DIR="${ANIFLIVE_TTS_SHARED_DIR}/official"
ANIFLIVE_TTS_OPEN_JTALK_DICT_DIR="${ANIFLIVE_TTS_VENV}/lib/python3.12/site-packages/pyopenjtalk/open_jtalk_dic_utf_8-1.11"

ANIFLIVE_TTS_CACHE_DIR="${ANIFLIVE_TTS_MACOS_RUNTIME_ROOT}/runtime/cache"
ANIFLIVE_TTS_VOICE_DIR="${ANIFLIVE_TTS_MACOS_RUNTIME_ROOT}/runtime/voices"
ANIFLIVE_TTS_PID_FILE="${ANIFLIVE_TTS_MACOS_RUNTIME_ROOT}/run/server.pid"
ANIFLIVE_TTS_HOST="127.0.0.1"
ANIFLIVE_TTS_PORT="29962"

# Optional build/install outputs; keep them outside the source tree.
ANIFLIVE_TTS_CARGO_TARGET_DIR="${ANIFLIVE_TTS_MACOS_RUNTIME_ROOT}/build/cargo-target-worker"
ANIFLIVE_TTS_SDK_CARGO_TARGET_DIR="${ANIFLIVE_TTS_MACOS_RUNTIME_ROOT}/build/cargo-target-sdk"
ANIFLIVE_TTS_CARGO_OFFLINE="0"

# For a prebuilt installation, set the path to the downloaded arm64 SDK wheel
# and set ANIFLIVE_TTS_BUILD_WORKER=0 when running install.sh.
# ANIFLIVE_TTS_SDK_WHEEL="/path/to/aniflive_tts-1.5.0-cp310-abi3-macosx_11_0_arm64.whl"

# install.sh dependency lock: FP16 (default) or FP32. start.sh takes the runtime
# precision from the model-package manifest; the two must describe one package.
ANIFLIVE_TTS_PRECISION="${ANIFLIVE_TTS_PRECISION:-FP16}"
